# Servidor (produção)
PORT=3001
NODE_ENV=production
JWT_SECRET=gere-uma-chave-longa-e-aleatoria-aqui

# Senhas iniciais (apenas na 1ª execução, quando o banco é criado)
ADMIN_PASSWORD=admin123
DEFAULT_USER_PASSWORD=kazulo123

# Caminho do SQLite (escolha UM cenário)
# Desenvolvimento local:
# DB_PATH=./server/data/kazulo.db
# Servidor na empresa (dados ficam no HD da Kazulo — recomendado para guardar meses):
# DB_PATH=D:\Kazulo\dados\kazulo.db
# Nuvem Railway com volume em /data:
# DB_PATH=/data/kazulo.db

# Desenvolvimento: origem do Vite
CLIENT_ORIGIN=http://localhost:5173

# --- Relatório diário por e-mail (fim do dia) ---
# Railway Hobby: SMTP (587) NÃO funciona — use Brevo (API HTTPS, plano grátis)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TO=Rodolfo <kazulo@kazulo.com.br>, Walter <Walter@kazulo.com.br>, Cristian <pcp@kazulo.com.br>
DAILY_REPORT_CRON=0 17 * * 1-5
DAILY_REPORT_TZ=America/Sao_Paulo

# Brevo: https://www.brevo.com → SMTP & API → gerar chave v3
BREVO_API_KEY=sua-chave-brevo-aqui
EMAIL_SENDER_EMAIL=kazuloworkflow@outlook.com
EMAIL_SENDER_NAME=KAZULO Workflow

# Opcional (SMTP só funciona fora do Railway Hobby / plano Pro)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# E-mail de apresentação (diretoria)
PUBLIC_SITE_URL=https://kazulo-workflow-production.up.railway.app
WELCOME_LOGIN_USER=admin
WELCOME_LOGIN_PASSWORD=defina-senha-exibida-no-email

# --- Backup automático SQLite ---
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_TZ=America/Sao_Paulo
BACKUP_RETAIN_COUNT=14
# BACKUP_DIR=/data/backups

# Domínio próprio: veja docs/DOMINIO.md (PUBLIC_SITE_URL + CNAME Railway)
