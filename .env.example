# Servidor (produção)
PORT=3001
NODE_ENV=production
JWT_SECRET=gere-uma-chave-longa-e-aleatoria-aqui

# Senhas iniciais (apenas na 1ª execução, quando o banco é criado)
ADMIN_PASSWORD=admin123
DEFAULT_USER_PASSWORD=kazulo123

# Caminho do SQLite (escolha UM cenário)
# Desenvolvimento local:
# DB_PATH=./server/data/kazulo.db
# Servidor na empresa (dados ficam no HD da Kazulo — recomendado para guardar meses):
# DB_PATH=D:\Kazulo\dados\kazulo.db
# Nuvem Railway com volume em /data:
# DB_PATH=/data/kazulo.db

# Desenvolvimento: origem do Vite
CLIENT_ORIGIN=http://localhost:5173

# --- Relatório diário por e-mail (fim do dia) ---
# Ative no Railway/servidor com SMTP real (Gmail app password, Brevo, etc.)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TO=gestor@empresa.com.br
# Segunda a sexta às 17:00 (horário de Brasília)
DAILY_REPORT_CRON=0 17 * * 1-5
DAILY_REPORT_TZ=America/Sao_Paulo

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app-do-gmail
SMTP_FROM=KAZULO Workflow <seu-email@gmail.com>

# E-mail de apresentação (diretoria)
PUBLIC_SITE_URL=https://kazulo-workflow-production.up.railway.app
WELCOME_LOGIN_USER=admin
WELCOME_LOGIN_PASSWORD=defina-senha-exibida-no-email
