# Servidor (produção)
PORT=3001
NODE_ENV=production
JWT_SECRET=gere-uma-chave-longa-e-aleatoria-aqui

# Senhas iniciais (apenas na 1ª execução, quando o banco é criado)
ADMIN_PASSWORD=admin123
DEFAULT_USER_PASSWORD=kazulo123

# Caminho do SQLite (escolha UM cenário)
# Desenvolvimento local:
# DB_PATH=./server/data/kazulo.db
# Servidor na empresa (dados ficam no HD da Kazulo — recomendado para guardar meses):
# DB_PATH=D:\Kazulo\dados\kazulo.db
# Nuvem Railway com volume em /data:
# DB_PATH=/data/kazulo.db

# Desenvolvimento: origem do Vite
CLIENT_ORIGIN=http://localhost:5173
